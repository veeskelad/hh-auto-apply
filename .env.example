# ── Доступ к дашборду ───────────────────────────────────────────
# Пароль на вход в дашборд. Если пусто — авторизация ВЫКЛЮЧЕНА (открытый доступ).
# Обязательно задайте непустой пароль, если дашборд доступен из интернета.
DASHBOARD_PASSWORD=

# Секрет для подписи cookie-сессии. Должен быть стабильным между рестартами
# (иначе все разлогинятся при перезапуске). Сгенерировать новый:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ── OAuth hh.ru (отклики через API, use_oauth_apply) ───────────
# client_id и client_secret приложения HH Android. Где взять — README, шаг 2.
# Пусто = отклики через API не работают, в debug.log будет об этом строка.
HH_OAUTH_CLIENT_ID=
HH_OAUTH_CLIENT_SECRET=

# ── LLM через OpenRouter ────────────────────────────────────────
# Нужен, только если письма пишет OpenRouter, а не подписка (claude -p или codex exec).
# Ключ: https://openrouter.ai/settings/keys → Create Key. В config.json профиль
# ссылается на него строкой "env:OPENROUTER_API_KEY". После правки перезапустить run.sh или run.bat.
OPENROUTER_API_KEY=
